{
  "name": "nomeatproxy",
  "version": "0.0.1",
  "private": true,
  "description": "A local safety net for autonomous coding agents.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "bin": { "nomeatproxy": "./dist/cli.js" },
  "exports": {
    ".": "./dist/engine.js",
    "./opencode": "./dist/adapters/opencode.js"
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "tsc",
    "build:native": "node scripts/build-native.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "bench": "npm run build && node scripts/bench.mjs",
    "evaluate": "npm run build && node scripts/evaluate.mjs",
    "test:native": "npm run build && npm run build:native && node --test test/runtime.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  }
}
