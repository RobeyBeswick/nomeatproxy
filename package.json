{
  "name": "nomeatproxy",
  "version": "0.0.1",
  "private": true,
  "description": "A local safety net for autonomous coding agents.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobeyBeswick/nomeatproxy.git"
  },
  "homepage": "https://github.com/RobeyBeswick/nomeatproxy#readme",
  "bugs": { "url": "https://github.com/RobeyBeswick/nomeatproxy/issues" },
  "keywords": ["ai", "agents", "hooks", "safety", "claude-code", "codex", "opencode"],
  "engines": { "node": ">=22" },
  "bin": { "nomeatproxy": "./dist/cli.js" },
  "exports": {
    ".": { "types": "./dist/engine.d.ts", "default": "./dist/engine.js" },
    "./opencode": { "types": "./dist/adapters/opencode.d.ts", "default": "./dist/adapters/opencode.js" }
  },
  "files": ["dist/**/*.js", "dist/**/*.d.ts", "docs/*.md", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "build:native": "node scripts/build-native.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "bench": "npm run build && node scripts/bench.mjs",
    "evaluate": "npm run build && node scripts/evaluate.mjs",
    "test:native": "npm run build && npm run build:native && node --test test/runtime.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  }
}
